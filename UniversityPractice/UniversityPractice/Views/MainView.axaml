<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:GameClubManager.Data.Models"
             x:Class="UniversityPractice.Views.MainView">

    <Grid Background="#111827">
        <StackPanel MaxWidth="300"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <Border Background="#1F2937" Padding="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="GAME CLUB MANAGER"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Управление игровым клубом"
                               Foreground="#9CA3AF"/>
                </StackPanel>
            </Border>

            <TabControl>
                <TabItem Header="Игроки">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" Spacing="8">
                            <TextBlock Text="Данные игрока"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="ФИО" Foreground="White"/>
                            <TextBox x:Name="FullNameBox"
                                     MinHeight="44"
                                     Watermark="Имя и фамилия"/>
                            <TextBlock Text="Никнейм" Foreground="White"/>
                            <TextBox x:Name="NicknameBox"
                                     MinHeight="44"
                                     Watermark="Игровой никнейм"/>
                            <TextBlock Text="Уровень членства" Foreground="White"/>
                            <TextBox x:Name="MembershipLevelBox"
                                     MinHeight="44"
                                     Watermark="Basic, Premium, VIP"/>
                            <Button Content="Новый игрок"
                                    MinHeight="44"
                                    Click="NewPlayer_Click"/>
                            <Button Content="Сохранить игрока"
                                    MinHeight="44"
                                    Click="SavePlayer_Click"/>
                            <Button Content="Удалить игрока"
                                    MinHeight="44"
                                    Background="#991B1B"
                                    Foreground="White"
                                    Click="DeletePlayer_Click"/>
                            <TextBlock x:Name="PlayerStatus"
                                       Foreground="#A78BFA"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Список игроков"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <ListBox x:Name="PlayersList"
                                     MaxHeight="250"
                                     SelectionChanged="PlayersList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Players">
                                        <StackPanel Margin="6" Spacing="3">
                                            <TextBlock Text="{Binding Nickname}"
                                                       FontWeight="Bold"
                                                       Foreground="#A78BFA"/>
                                            <TextBlock Text="{Binding FullName}"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding MembershipLevel}"
                                                       Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Сеансы выбранного игрока"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <ListBox x:Name="PlayerSessionsList"
                                     MaxHeight="250">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameSessions">
                                        <StackPanel Margin="6" Spacing="3">
                                            <TextBlock Text="{Binding Game.Title}"
                                                       Foreground="#A78BFA"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding StartedAt}"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding DurationMinutes}"
                                                       Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Игры">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" Spacing="8">
                            <TextBlock Text="Данные игры"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Название" Foreground="White"/>
                            <TextBox x:Name="GameTitleBox"
                                     MinHeight="44"
                                     Watermark="Название игры"/>
                            <TextBlock Text="Жанр" Foreground="White"/>
                            <TextBox x:Name="GameGenreBox"
                                     MinHeight="44"
                                     Watermark="Жанр"/>
                            <TextBlock Text="Разработчик" Foreground="White"/>
                            <TextBox x:Name="GameDeveloperBox"
                                     MinHeight="44"
                                     Watermark="Разработчик"/>
                            <TextBlock Text="Возрастной рейтинг" Foreground="White"/>
                            <TextBox x:Name="GameAgeRatingBox"
                                     MinHeight="44"
                                     Watermark="Например: 16+"/>
                            <Button Content="Новая игра"
                                    MinHeight="44"
                                    Click="NewGame_Click"/>
                            <Button Content="Сохранить игру"
                                    MinHeight="44"
                                    Click="SaveGame_Click"/>
                            <Button Content="Удалить игру"
                                    MinHeight="44"
                                    Background="#991B1B"
                                    Foreground="White"
                                    Click="DeleteGame_Click"/>
                            <TextBlock x:Name="GameStatus"
                                       Foreground="#A78BFA"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Список игр"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <ListBox x:Name="GamesList"
                                     MaxHeight="300"
                                     SelectionChanged="GamesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Games">
                                        <StackPanel Margin="6" Spacing="3">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#A78BFA"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Genre}"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding Developer}"
                                                       Foreground="#9CA3AF"/>
                                            <TextBlock Text="{Binding AgeRating}"
                                                       Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Сеансы">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" Spacing="8">
                            <TextBlock Text="Данные сеанса"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Игрок" Foreground="White"/>
                            <ComboBox x:Name="SessionPlayerCombo"
                                      MinHeight="44"
                                      PlaceholderText="Выберите игрока">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Players">
                                        <TextBlock Text="{Binding Nickname}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Игра" Foreground="White"/>
                            <ComboBox x:Name="SessionGameCombo"
                                      MinHeight="44"
                                      PlaceholderText="Выберите игру">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Games">
                                        <TextBlock Text="{Binding Title}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Дата" Foreground="White"/>
                            <DatePicker x:Name="SessionDatePicker"
                                        MinHeight="44"/>
                            <TextBlock Text="Время" Foreground="White"/>
                            <TimePicker x:Name="SessionTimePicker"
                                        MinHeight="44"/>
                            <TextBlock Text="Длительность (минуты)" Foreground="White"/>
                            <TextBox x:Name="SessionDurationBox"
                                     MinHeight="44"
                                     Watermark="Например: 60"/>
                            <TextBlock Text="Очки (необязательно)" Foreground="White"/>
                            <TextBox x:Name="SessionScoreBox"
                                     MinHeight="44"
                                     Watermark="Например: 1500"/>
                            <Button Content="Новый сеанс"
                                    MinHeight="44"
                                    Click="NewSession_Click"/>
                            <Button Content="Сохранить сеанс"
                                    MinHeight="44"
                                    Click="SaveSession_Click"/>
                            <Button Content="Удалить сеанс"
                                    MinHeight="44"
                                    Background="#991B1B"
                                    Foreground="White"
                                    Click="DeleteSession_Click"/>
                            <TextBlock x:Name="SessionStatus"
                                       Foreground="#A78BFA"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Список сеансов"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <ListBox x:Name="SessionsList"
                                     MaxHeight="300"
                                     SelectionChanged="SessionsList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameSessions">
                                        <StackPanel Margin="6" Spacing="3">
                                            <TextBlock Text="{Binding Game.Title}"
                                                       Foreground="#A78BFA"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Player.Nickname}"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding StartedAt}"
                                                       Foreground="#9CA3AF"/>
                                            <TextBlock Text="{Binding DurationMinutes}"
                                                       Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Grid>
</UserControl>
