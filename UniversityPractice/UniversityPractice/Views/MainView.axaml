<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:GameClubManager.Data.Models"
             x:Class="UniversityPractice.Views.MainView">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#17263B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#3B4B63"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#17263B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
        <Style Selector="DatePicker">
            <Setter Property="Background" Value="#17263B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
        <Style Selector="TimePicker">
            <Setter Property="Background" Value="#17263B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#111C2E"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#0B1220">
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#111C2E" Padding="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="GAME CLUB MANAGER"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"/>
                    <TextBlock Text="Управление игровым клубом"
                               Foreground="#B8C5D6"/>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1">
                <TabItem Header="Игроки">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" Spacing="8">
                            <TextBlock Text="Данные игрока"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                            <TextBlock Text="ФИО" Foreground="#F8FAFC"/>
                            <TextBox x:Name="FullNameBox"
                                     MinHeight="44"
                                     Watermark="Имя и фамилия"/>
                            <TextBlock Text="Никнейм" Foreground="#F8FAFC"/>
                            <TextBox x:Name="NicknameBox"
                                     MinHeight="44"
                                     Watermark="Игровой никнейм"/>
                            <TextBlock Text="Уровень членства" Foreground="#F8FAFC"/>
                            <TextBox x:Name="MembershipLevelBox"
                                     MinHeight="44"
                                     Watermark="Basic, Premium, VIP"/>
                            <Button Content="Новый игрок"
                                    MinHeight="44"
                                    Click="NewPlayer_Click"/>
                            <Button Content="Сохранить игрока"
                                    MinHeight="44"
                                    Click="SavePlayer_Click"/>
                            <Button Content="Удалить игрока"
                                    MinHeight="44"
                                    Background="#B91C1C"
                                    Foreground="#F8FAFC"
                                    Click="DeletePlayer_Click"/>
                            <TextBlock x:Name="PlayerStatus"
                                       Foreground="#5EEAD4"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Список игроков"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                            <ListBox x:Name="PlayersList"
                                     MaxHeight="250"
                                     SelectionChanged="PlayersList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Players">
                                        <StackPanel Margin="6" Spacing="3">
                                            <TextBlock Text="{Binding Nickname}"
                                                       FontWeight="Bold"
                                                       Foreground="#5EEAD4"/>
                                            <TextBlock Text="{Binding FullName}"
                                                       Foreground="#F8FAFC"/>
                                            <TextBlock Text="{Binding MembershipLevel}"
                                                       Foreground="#B8C5D6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Сеансы выбранного игрока"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                            <ListBox x:Name="PlayerSessionsList"
                                     MaxHeight="250">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameSessions">
                                        <StackPanel Margin="6" Spacing="3">
                                            <TextBlock Text="{Binding Game.Title}"
                                                       Foreground="#5EEAD4"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding StartedAt}"
                                                       Foreground="#F8FAFC"/>
                                            <TextBlock Text="{Binding DurationMinutes}"
                                                       Foreground="#B8C5D6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Игры">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" Spacing="8">
                            <TextBlock Text="Данные игры"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                            <TextBlock Text="Название" Foreground="#F8FAFC"/>
                            <TextBox x:Name="GameTitleBox"
                                     MinHeight="44"
                                     Watermark="Название игры"/>
                            <TextBlock Text="Жанр" Foreground="#F8FAFC"/>
                            <TextBox x:Name="GameGenreBox"
                                     MinHeight="44"
                                     Watermark="Жанр"/>
                            <TextBlock Text="Разработчик" Foreground="#F8FAFC"/>
                            <TextBox x:Name="GameDeveloperBox"
                                     MinHeight="44"
                                     Watermark="Разработчик"/>
                            <TextBlock Text="Возрастной рейтинг" Foreground="#F8FAFC"/>
                            <TextBox x:Name="GameAgeRatingBox"
                                     MinHeight="44"
                                     Watermark="Например: 16+"/>
                            <Button Content="Новая игра"
                                    MinHeight="44"
                                    Click="NewGame_Click"/>
                            <Button Content="Сохранить игру"
                                    MinHeight="44"
                                    Click="SaveGame_Click"/>
                            <Button Content="Удалить игру"
                                    MinHeight="44"
                                    Background="#B91C1C"
                                    Foreground="#F8FAFC"
                                    Click="DeleteGame_Click"/>
                            <TextBlock x:Name="GameStatus"
                                       Foreground="#5EEAD4"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Список игр"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                            <ListBox x:Name="GamesList"
                                     MaxHeight="300"
                                     SelectionChanged="GamesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Games">
                                        <StackPanel Margin="6" Spacing="3">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#5EEAD4"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Genre}"
                                                       Foreground="#F8FAFC"/>
                                            <TextBlock Text="{Binding Developer}"
                                                       Foreground="#B8C5D6"/>
                                            <TextBlock Text="{Binding AgeRating}"
                                                       Foreground="#B8C5D6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Сеансы">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" Spacing="8">
                            <TextBlock Text="Данные сеанса"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                            <TextBlock Text="Игрок" Foreground="#F8FAFC"/>
                            <ComboBox x:Name="SessionPlayerCombo"
                                      MinHeight="44"
                                      PlaceholderText="Выберите игрока">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Players">
                                        <TextBlock Text="{Binding Nickname}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Игра" Foreground="#F8FAFC"/>
                            <ComboBox x:Name="SessionGameCombo"
                                      MinHeight="44"
                                      PlaceholderText="Выберите игру">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Games">
                                        <TextBlock Text="{Binding Title}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Дата" Foreground="#F8FAFC"/>
                            <DatePicker x:Name="SessionDatePicker"
                                        MinHeight="44"/>
                            <TextBlock Text="Время" Foreground="#F8FAFC"/>
                            <TimePicker x:Name="SessionTimePicker"
                                        MinHeight="44"/>
                            <TextBlock Text="Длительность (минуты)" Foreground="#F8FAFC"/>
                            <TextBox x:Name="SessionDurationBox"
                                     MinHeight="44"
                                     Watermark="Например: 60"/>
                            <TextBlock Text="Депозит (необязательно)" Foreground="#F8FAFC"/>
                            <TextBox x:Name="SessionDepositBox"
                                     MinHeight="44"
                                     Watermark="Например: 500"/>
                            <Button Content="Новый сеанс"
                                    MinHeight="44"
                                    Click="NewSession_Click"/>
                            <Button Content="Сохранить сеанс"
                                    MinHeight="44"
                                    Click="SaveSession_Click"/>
                            <Button Content="Удалить сеанс"
                                    MinHeight="44"
                                    Background="#B91C1C"
                                    Foreground="#F8FAFC"
                                    Click="DeleteSession_Click"/>
                            <TextBlock x:Name="SessionStatus"
                                       Foreground="#5EEAD4"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Список сеансов"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                            <ListBox x:Name="SessionsList"
                                     MaxHeight="300"
                                     SelectionChanged="SessionsList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameSessions">
                                        <StackPanel Margin="6" Spacing="3">
                                            <TextBlock Text="{Binding Game.Title}"
                                                       Foreground="#5EEAD4"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Player.Nickname}"
                                                       Foreground="#F8FAFC"/>
                                            <TextBlock Text="{Binding StartedAt}"
                                                       Foreground="#B8C5D6"/>
                                            <TextBlock Text="{Binding DurationMinutes}"
                                                       Foreground="#B8C5D6"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
